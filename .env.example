# Copy to .env and fill in.
# The containers run as the user who runs `docker compose` ($USER / $HOME)
# and bind-mount that user's ~/.claude, ~/.t3 and
# ~/.local/state/herdr-core.

# --- host user -----------------------------------------------------------------
# uid/gid of $USER (`id -u` / `id -g`). zsh/bash don't export UID, so set here.
HOST_UID=1000
HOST_GID=1000
# Projects dir, mounted at the same path (T3 worktrees and Claude history
# refer to absolute paths). Default: $HOME/dev
WORK_DIR=
# Rootless podman only: keep-id (maps your uid 1:1). Leave empty for docker.
USERNS_MODE=

# --- tailscale ---------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys.
# Only needed for the first start; state is kept in the tailscale-state volume.
TS_AUTHKEY=
TS_HOSTNAME=remote-dev
# Tailnet IP or name of an exit node. Set it to send ALL egress of every
# container through the tailnet; leave empty to tunnel only tailnet traffic.
TS_EXIT_NODE=
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:dev
TS_EXTRA_ARGS=

# --- t3 server -------------------------------------------------------------------
# 0.0.0.0 = reachable at http://<TS_HOSTNAME>:3773 on the tailnet (pairing
# still required). 127.0.0.1 = only from inside the shared network namespace.
T3_HOST=0.0.0.0
